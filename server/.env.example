# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_alert_db
DB_USER=postgres
DB_PASSWORD=Password
# Auth
JWT_SECRET=JWT_SECRET_KEY
JWT_EXPIRES_IN=7d

# Notifications
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="StockWatch <alerts@example.com>"

# NigeriaBulkSMS (portal.nigeriabulksms.com)
SMS_ENABLED=false
NIGERIA_BULK_SMS_URL=https://portal.nigeriabulksms.com/api/
NIGERIA_BULK_SMS_USERNAME=
NIGERIA_BULK_SMS_PASSWORD=
NIGERIA_BULK_SMS_SENDER=StockWatch

# Python AI forecasting service (see ai-service/) — used by the
# /api/inventory/ai-* proxy routes for richer predictions
AI_SERVICE_URL=http://localhost:8000

# CORS
CLIENT_URL=http://localhost:3000
