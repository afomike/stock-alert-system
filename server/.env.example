# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_alert_db
DB_USER=postgres
DB_PASSWORD=postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Notifications (optional - stubbed by default)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Python AI forecasting service (see ai-service/) — used by the
# /api/inventory/ai-* proxy routes for richer predictions
AI_SERVICE_URL=http://localhost:8000

# CORS
CLIENT_URL=http://localhost:3000
